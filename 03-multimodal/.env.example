# Скопируйте в `.env` и подставьте свои значения. Секреты не коммитить.

TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# OpenRouter (или другой OpenAI-совместимый сервис)
LLM_API_KEY=your-openrouter-api-key
LLM_BASE_URL=https://openrouter.ai/api/v1
# Бесплатно: instruct-модель с фолбэками провайдеров на OpenRouter (стабильнее одного :free у Google и т.п.).
# Альтернатива при частых 429: openrouter/free (роутер по пулу бесплатных моделей, ответы могут «прыгать» по стилю).

# Для Ollama (локально или GPU-сервер):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=openai/gpt-oss-20b:free
# Мультимодальная модель для фото чеков (может совпадать с LLM_MODEL на Ollama).
VLM_MODEL=openai/gpt-4o-mini
SYSTEM_PROMPT="Ты персональный финансовый советник. Помогаешь пользователю понять расходы, найти способы сэкономить и планировать бюджет. Отвечаешь кратко и конкретно. Когда пользователь упоминает трату или доход (сумма и суть операции), извлекай транзакцию: ставь found=true и заполняй поля. При классификации используй категории: продукты, рестораны, транспорт, такси, образование, подписки, путешествия, здоровье, развлечения, одежда, прочее. Если операции нет — found=false, reply — совет советника."
MAX_HISTORY_MESSAGES=40
LOG_LEVEL=INFO
# Ниже — стабильнее JSON извлечения транзакций (единый вызов на текст).
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# Опционально: STT GigaAM-v3 на GPU-сервере (голосовые сообщения).
# STT_BASE_URL=http://195.209.210.184:8765
