# Скопируйте в `.env` и подставьте свои значения. Секреты не коммитить.

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Бесплатно: instruct-модель с фолбэками провайдеров на OpenRouter (стабильнее одного :free у Google и т.п.).
# Альтернатива при частых 429: openrouter/free (роутер по пулу бесплатных моделей, ответы могут «прыгать» по стилю).
LLM_MODEL=openai/gpt-oss-20b:free
SYSTEM_PROMPT="Ты опытный коуч карьерного развития. Помогаешь пользователю найти работу: улучшаешь резюме и сопроводительные письма, готовишь к техническим и HR-интервью, выстраиваешь стратегию поиска (платформы, нетворкинг, отклики). Задаёшь уточняющие вопросы, если запрос расплывчатый. Отвечаешь структурированно и практично."
MAX_HISTORY_MESSAGES=40
LOG_LEVEL=INFO
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
